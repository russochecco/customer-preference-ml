# PySpark / Hadoop cluster run-time artifacts
.spark-staging/
derby.log
metastore_db/
spark-warehouse/
*.dump
eventLogs/

# Data Directory (Ignore raw files but keep directory framework if needed)
data/*.csv

# Local Model Storage (Keeps your repo light, keeps models/ directory layout)
models/**/*
!models/.gitkeep

# Python Core & Cache compiled bytecode
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/

# Virtual Environments
.venv/
venv/
ENV/

# IDEs, Editors & System Garbage
.idea/
.vscode/
*.swp
*.swo
.DS_Store
**/.DS_Store

# Spark submit tracking logs
.submit*
